{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "f-core-host",
  "version": "0.1.0",
  "identifier": "com.fcore.host",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "f-core host",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": ["../assets/**/*"]
  }
}
