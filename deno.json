{
  "tasks": {
    "dev": "deno run --watch main.ts",
    "test": "deno test --allow-run --allow-write --allow-read",
    "test:pr": "deno test --allow-run --allow-write --allow-read main_test.ts cli_test.ts ir/validate_test.ts vm/runner_test.ts plugin/capability_test.ts plugin/isolated_runtime_test.ts && deno task gate:boundary && deno task gate:operations && deno task gate:fork-policy",
    "test:ci": "deno test --allow-run --allow-write --allow-read && deno task gate:boundary && deno task gate:presentation && deno task gate:operations && deno task gate:gui-bridge && deno task gate:fork-policy",
    "audit:plugins": "deno run --allow-read scripts/check_plugin_license_gate.ts",
    "gate:boundary": "deno run --allow-run scripts/check_boundary_gates.ts",
    "gate:presentation": "deno run --allow-run --allow-env=F_CORE_GATE_TIMEOUT_MS scripts/check_presentation_gate.ts",
    "gate:operations": "deno run --allow-run --allow-read scripts/check_operations_gate.ts",
    "gate:gui-bridge": "deno run --allow-run scripts/check_gui_bridge_gate.ts",
    "gate:fork-policy": "deno run --allow-read scripts/check_fork_policy_gate.ts",
    "bench:candidate:a": "deno run --allow-run --allow-read --allow-write scripts/bench_candidate.ts a",
    "bench:candidate:b": "deno run --allow-run --allow-read --allow-write scripts/bench_candidate.ts b",
    "bench:candidate:c": "deno run --allow-run --allow-read --allow-write scripts/bench_candidate.ts c"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "recommended": true
    }
  }
}
